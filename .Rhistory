clean_health_data <- data %>%
# 1. Only keep the actual point estimates (ignore upper/lower error bounds)
filter(Margins_label == "Value") %>%
# 2. Select only the human-readable columns you need
select(
Year = Periods_label,
Group = Characteristics_label,
Good_Health_Pct = `SelfPerceivedHealthGoodOrVeryGood_1`,
Anxiety_Depression_Pct = `FeelingsOfAnxietyOrDepression4Wks_2`,
GP_Contact_Pct = `PersonsWithAt Least1Contact_7`
) %>%
# 3. Drop rows where your target plotting data is missing
filter(!is.na(Good_Health_Pct))
