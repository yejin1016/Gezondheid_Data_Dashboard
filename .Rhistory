data <- cbs_get_data("85454eng") %>%
cbs_add_label_columns()
data_filter_and_extract_group <- data %>%
separate_wider_delim(
cols = Characteristics_label,
delim = ": ",
names = c("Category", "Subcategory"),
too_few = "align_start"
) %>%
mutate(Subcategory = ifelse(is.na(Subcategory), "Total", Subcategory))
mvh_shiny_data <- data_filter_and_extract_group %>%
filter(Margins_label == "Value") %>%
select(
Year = Periods_label,
Category,
Subcategory,
# Your 5 targeted healthcare metrics
Overall_Wellness = GoodOrVeryGood_1,
GP_Visit_Rate = PersonsWithAtLeast1Contact_85,
Psychological_Distress = PsychologicalDistressPast4Weeks_5,
Chronic_Disorder_Rate = k_1OrMoreChronicDisorders_27,
Diabetes_Rate = DiabetesTotal_28
)
